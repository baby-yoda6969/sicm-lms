rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'ADMIN' || request.auth.token.admin == true);
    }

    function isTeacher() {
      return isAuthenticated() && (getUserRole() == 'TEACHER' || isAdmin());
    }

    function isStudent() {
      return isAuthenticated() && (getUserRole() == 'STUDENT' || isAdmin());
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId) || isAdmin();
    }

    // 2. Students & Academic Records
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Teachers & Availability
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isTeacher() && request.auth.uid == resource.data.userId);
    }

    // 4. Courses & Subjects
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Timetable Schedule
    match /timetable/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Attendance Sessions & Records
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() || isAdmin();
    }

    match /attendance_records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isTeacher() || isAdmin();
    }

    // 7. Assignments & Submissions
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isStudent();
      allow update: if isStudent() || isTeacher();
      allow delete: if isAdmin();
    }

    // 8. Learning Materials
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();
    }

    // 9. Announcements & Notifications
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
